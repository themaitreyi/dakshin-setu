# Frontend server: points to the private Python service.
POLAR_API_URL=http://127.0.0.1:4000
# Python service: server-only. Never use VITE_ for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CURATOR_TOKEN=
COOKIE_SECURE=1
POLAR_PRODUCTION_CORE_DIR=./backend/polar_production_core
# Leave DATABASE_URL unset for persistent local SQLite.
# DATABASE_URL=postgresql+psycopg://user:password@database/dakshinsetu
# STORAGE_DIR=/data
